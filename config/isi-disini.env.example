# ================== TEMPEL TEPAT SESUDAH TANDA = (tanpa spasi, tanpa kutip) ==================

RPC_API_KEY=
WALLET_PRIVATE_KEY=
SETORAN_USD=100
MODE=live

# ======== lalu simpan: Ctrl+O, Enter, Ctrl+X ==================================================
#
#  RPC_API_KEY         URL RPC berbayar UTUH, api key-nya sudah di dalam link. Kosong = RPC publik.
#                      Harus EVM Robinhood Chain (chainId 4663): QuickNode, Alchemy, Dwellir,
#                      ArrowRPC, Goldsky. RPC Solana (Helius dsb) ditolak.
#                      contoh:  https://xxx.quiknode.pro/abc123/
#                               https://edge.goldsky.com/standard/evm/4663?key=abc123
#
#  WALLET_PRIVATE_KEY  MetaMask -> titik tiga -> Account details -> Show private key.
#                      64 karakter heksadesimal, boleh diawali 0x.
#                      BUKAN seed phrase 12 kata. Pakai akun khusus bot, bukan akun utama.
#
#  SETORAN_USD         USD yang benar-benar Anda kirim ke wallet bot (acuan ukuran posisi).
#
#  MODE                off    = paper, tanpa transaksi
#                      shadow = disimulasikan, tidak dikirim (butuh RPC dengan debug_traceCall)
#                      live   = TRANSAKSI SUNGGUHAN DENGAN UANG ANDA (bawaan: langsung trading)
#
#  Setelah disimpan, RPC_API_KEY dan WALLET_PRIVATE_KEY DIKOSONGKAN OTOMATIS: kunci dipindah
#  ke /opt/rhc/secrets/wallet.key (izin 600), URL RPC ke /opt/rhc/bot/.env.
#
#  ISI DI VPS SAJA. JANGAN PERNAH isi berkas ini lewat website GitHub: repo ini publik,
#  private key yang ter-commit dikuras bot pencuri dalam hitungan menit.
#  Berkas terisi (config/isi-disini.env) sudah ditutup .gitignore.
#
# ---------------------------------------------- batas pengaman (boleh dibiarkan)
# hanya bisa membatalkan beli / memaksa jual, tidak mengubah keputusan strategi
MAKS_USD_PER_BELI=5          # 0 = tanpa batas
STOP_RUGI_HARIAN_USD=25      # 0 = mati
MAKS_POSISI_TERBUKA=4
