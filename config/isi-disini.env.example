# ============================================================================
#  ISI 4 KOLOM DI BAWAH, LALU JALANKAN:  sudo deploy/pasang.sh
# ============================================================================
#
#  Berkas ini HANYA formulir isian. Setelah dipasang, baris RPC_API_KEY dan
#  WALLET_PRIVATE_KEY DIKOSONGKAN OTOMATIS: kunci dipindah ke berkas kunci
#  tersendiri dengan izin 600, dan URL RPC lengkap ditulis ke .env.
#
#  JANGAN commit berkas ini ke git setelah diisi (.gitignore sudah menutupinya).
#
# ----------------------------------------------------------------------------
#  KOLOM 1 — URL RPC BERBAYAR  (boleh dikosongkan = pakai RPC publik)
# ----------------------------------------------------------------------------
#  Harus RPC EVM untuk Robinhood Chain, chainId 4663.
#  Penyedia: QuickNode, Alchemy, Dwellir, ArrowRPC, Goldsky.
#  RPC Solana (Helius dsb) TIDAK BISA dipakai dan akan ditolak.
#  Pilih paket yang punya Debug/Trace API kalau mau pakai EXEC_MODE=shadow.
#
#  Tempel URL utuh, lengkap dengan api key-nya. Contoh bentuknya:
#    https://xxx.quiknode.pro/abc123/
#    https://edge.goldsky.com/standard/evm/4663?key=abc123
#
RPC_API_KEY=


# ----------------------------------------------------------------------------
#  KOLOM 2 — PRIVATE KEY WALLET BOT (MetaMask)
# ----------------------------------------------------------------------------
#  Buat akun BARU khusus bot. Jangan pakai akun utama Anda.
#    MetaMask -> Add account -> Add a new account -> beri nama "Bot Trading"
#    lalu titik tiga -> Account details -> Show private key -> salin
#
#  64 karakter heksadesimal, boleh diawali 0x.
#  Seed phrase MetaMask tetap jadi cadangan Anda kalau VPS hilang.
#
WALLET_PRIVATE_KEY=


# ----------------------------------------------------------------------------
#  KOLOM 3 — SETORAN ANDA DALAM USD
# ----------------------------------------------------------------------------
#  Isi sama dengan jumlah USD yang benar-benar Anda kirim ke wallet bot.
#  Angka ini jadi acuan ekuitas untuk menghitung ukuran posisi.
#
SETORAN_USD=100


# ----------------------------------------------------------------------------
#  KOLOM 4 — MODE
# ----------------------------------------------------------------------------
#  off     = paper trading, tidak ada transaksi. Mulai dari sini.
#  shadow  = order dibangun, ditandatangani, disimulasikan. Tidak dibroadcast.
#            Butuh RPC yang mendukung debug_traceCall.
#  live    = TRANSAKSI SUNGGUHAN DENGAN UANG ANDA.
#
MODE=off


# ----------------------------------------------------------------------------
#  BATAS PENGAMAN  (boleh dibiarkan; hanya bisa membatalkan beli / memaksa jual)
# ----------------------------------------------------------------------------
MAKS_USD_PER_BELI=5          # 0 = tanpa batas
STOP_RUGI_HARIAN_USD=25      # 0 = mati
MAKS_POSISI_TERBUKA=4
